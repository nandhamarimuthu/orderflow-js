{
  "name": "orderflow-platform-js",
  "version": "1.4.2",
  "description": "Intentionally vulnerable OrderFlow fixture for SkyForge AI",
  "private": true,
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node src/server.js",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "lint": "eslint src"
  },
  "dependencies": {
    "express": "4.17.1",
    "lodash": "4.17.20",
    "jsonwebtoken": "8.5.1",
    "axios": "0.21.1",
    "qs": "6.5.2",
    "minimist": "1.2.5",
    "node-fetch": "2.6.1",
    "multer": "1.4.2",
    "cookie-parser": "1.4.5",
    "handlebars": "4.7.6",
    "serialize-javascript": "3.1.0",
    "aws-sdk": "2.814.0",
    "mysql": "2.18.1",
    "mongoose": "5.11.15",
    "helmet": "4.4.1"
  },
  "devDependencies": {
    "jest": "27.0.6",
    "supertest": "6.1.3",
    "eslint": "7.20.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": ["**/unit-tests/**/*.test.js", "**/functional-tests/**/*.test.js"],
    "collectCoverageFrom": ["src/**/*.js"],
    "coverageDirectory": "coverage"
  }
}
