resource "aws_db_subnet_group" "main" { name = "orderflow-db-subnets"
  subnet_ids = [aws_subnet.a.id, aws_subnet.b.id, aws_subnet.c.id] }
resource "aws_db_instance" "primary" { identifier = "orderflow-primary"
  allocated_storage = 2000
  storage_type = "io1"
  iops = 20000
  engine = "postgres"
  engine_version = "14.7"
  instance_class = "db.r5.4xlarge"
  username = "orderflow"
  password = "example-only-password"
  db_subnet_group_name = aws_db_subnet_group.main.name
  publicly_accessible = true
  storage_encrypted = false
  multi_az = true
  skip_final_snapshot = true
  deletion_protection = false }
resource "aws_db_instance" "reporting" { identifier = "orderflow-reporting"
  allocated_storage = 1000
  storage_type = "gp2"
  engine = "postgres"
  engine_version = "14.7"
  instance_class = "db.m5.2xlarge"
  username = "orderflow"
  password = "example-only-password"
  db_subnet_group_name = aws_db_subnet_group.main.name
  publicly_accessible = true
  storage_encrypted = false
  skip_final_snapshot = true
  deletion_protection = false }
