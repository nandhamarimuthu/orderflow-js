resource "aws_iam_role" "lambda_role" { name = "orderflow-lambda-role"
  assume_role_policy = jsonencode({ Version = "2012-10-17", Statement = [{ Action = "sts:AssumeRole", Effect = "Allow", Principal = { Service = "lambda.amazonaws.com" } }] }) }
resource "aws_lambda_function" "ingest" { function_name = "orderflow-ingest"
  role = aws_iam_role.lambda_role.arn
  handler = "order_ingest.handler"
  runtime = "python3.8"
  filename = "placeholder.zip"
  source_code_hash = filebase64sha256("placeholder.zip")
  memory_size = 10240
  timeout = 900
  architectures = ["x86_64"]
  environment { variables = { PAYMENT_TOKEN = "sk_test_EXAMPLE_ONLY" } } }
resource "aws_lambda_function" "invoice" { function_name = "orderflow-invoice"
  role = aws_iam_role.lambda_role.arn
  handler = "invoice_generator.handler"
  runtime = "python3.8"
  filename = "placeholder.zip"
  source_code_hash = filebase64sha256("placeholder.zip")
  memory_size = 10240
  timeout = 900
  architectures = ["x86_64"] }
resource "aws_lambda_function" "reconcile" { function_name = "orderflow-reconcile"
  role = aws_iam_role.lambda_role.arn
  handler = "nightly_reconcile.handler"
  runtime = "python3.8"
  filename = "placeholder.zip"
  source_code_hash = filebase64sha256("placeholder.zip")
  memory_size = 10240
  timeout = 900
  architectures = ["x86_64"] }
resource "aws_lambda_function" "resize" { function_name = "orderflow-resize"
  role = aws_iam_role.lambda_role.arn
  handler = "image_resize.handler"
  runtime = "python3.8"
  filename = "placeholder.zip"
  source_code_hash = filebase64sha256("placeholder.zip")
  memory_size = 10240
  timeout = 900
  architectures = ["x86_64"] }
